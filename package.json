{
  "name": "emdash-media-unsplash",
  "version": "0.2.1",
  "type": "module",
  "description": "Unsplash media provider for EmDash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielnv18/emdash-media-unsplash.git"
  },
  "bugs": "https://github.com/danielnv18/emdash-media-unsplash/issues",
  "keywords": [
    "emdash",
    "media-provider",
    "unsplash"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./admin-cache": {
      "types": "./dist/admin-cache.d.ts",
      "default": "./dist/admin-cache.js"
    },
    "./api": {
      "types": "./dist/api/client.d.ts",
      "default": "./dist/api/client.js"
    },
    "./mapping": {
      "types": "./dist/mapping/unsplash-to-emdash.d.ts",
      "default": "./dist/mapping/unsplash-to-emdash.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "emdash": "^1.0.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
